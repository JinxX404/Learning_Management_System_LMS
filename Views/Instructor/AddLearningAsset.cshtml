@model Learning_Management_System.ViewModels.Instructor.Response.AddLearningAssetResponseViewModel

@{
    ViewData["Title"] = "Add Learning Asset";
    var lectureId = Model.LectureId;
    var lectureTitle = Model.LectureTitle;
    var courseId = Model.CourseId;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4>
                <i class="bi bi-file-earmark-plus"></i> Add Learning Asset
                @if (!string.IsNullOrEmpty(lectureTitle))
                {
                    <small class="ms-2">→ Lecture: <strong>@lectureTitle</strong></small>
                }
            </h4>
        </div>
        <div class="card-body">
            <form asp-action="AddLearningAsset" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="lectureId" value="@lectureId" />
                <input type="hidden" name="courseId" value="@courseId" />

                <div class="mb-3">
                    <label for="Title" class="form-label">Title</label>
                    <input id="Title" name="Title" class="form-control" placeholder="e.g., Lecture Slides, Demo Video" />
                    <span class="text-danger" data-valmsg-for="Title"></span>
                </div>

                <div class="mb-3">
                    <label for="AssetType" class="form-label">Asset Type</label>
                    <select id="AssetType" name="AssetType" class="form-select">
                        <option value="">-- Select Type --</option>
                        <option value="Video">Video</option>
                        <option value="PDF">Document(PDF | DOCX | PowerPoint)</option>
                        @* <option value="PPT">PowerPoint</option> *@
                        <option value="Link">Link</option>
                        @* <option value="Code">Code File</option> *@
                    </select>
                    <span class="text-danger" data-valmsg-for="AssetType"></span>
                </div>

                <div class="mb-3">
                    <label for="FileUrl" class="form-label">File URL</label>
                    <input id="FileUrl" name="FileUrl" type="url" class="form-control"
                           placeholder="https://example.com/asset.pdf" />
                    <div class="form-text">
                        Must be a direct, public URL (e.g., Google Drive share link with access=anyone).
                    </div>
                    <span class="text-danger" data-valmsg-for="FileUrl"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="CourseDetails" asp-controller="Instructor"
                       asp-route-id="@courseId"
                       class="btn btn-secondary">← Cancel</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Save Asset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}